//@version=6
indicator("Fractal Reclaim Strength", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ==========================================
// 1. INPUTS
// The latest C2 setup as two levels (the swept C1 extreme and the
// C2 extreme that must hold) plus a survival table by Reclaim Strength.
// ==========================================
grp_visual = "Levels"
grp_table  = "Stats Table"

show_lines       = input.bool(true, "Level Lines", group=grp_visual, tooltip="The swept C1 extreme (dotted gray) and the C2 extreme that must hold (direction color), drawn from C2 to the end of C4.")
show_line_labels = input.bool(true, "Labels", group=grp_visual, tooltip="C2 with its Reclaim Strength on the C2 candle, and the C2 extreme price at the end of its line (XC2 once it breaks).")
bull_col         = input.color(#2962ff, "Bullish", inline="clr", group=grp_visual)
bear_col         = input.color(#f23645, "Bearish", inline="clr", group=grp_visual)

show_tbl    = input.bool(true, "Show Table", inline="tbl_view", group=grp_table, tooltip="The latest setup and the historical C2-extreme survival rates by Reclaim Strength (not trade win rates). Every completed setup is counted, overlapping ones included.")
tbl_pos     = input.string("Top Right", "Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], inline="tbl_view", group=grp_table)
tbl_size_in = input.string("Compact", "Size", options=["Compact", "Tiny", "Normal"], inline="tbl_view", group=grp_table)
bars_mode   = input.string("All Available Bars", "Sample", options=["All Available Bars", "Last 5000 Bars", "Last 1000 Bars", "Last 500 Bars"], group=grp_table, tooltip="Uses this chart's bars and feed. Last N Bars counts C2s among the latest N closed bars whose C4 has closed. Updates on bar close. Session gaps are not filtered.")

// ==========================================
// 2. HELPERS
// ==========================================
// Engine, drawings and table are off below 15 minutes
int tf_sec = timeframe.in_seconds()
bool is_too_low = na(tf_sec) ? ((timeframe.isseconds) or (timeframe.isminutes and timeframe.multiplier < 15)) : (tf_sec < 900)

get_bin(float rs) =>
    int b = 0
    if rs < 10.0
        b := 0
    else if rs < 25.0
        b := 1
    else if rs < 50.0
        b := 2
    else if rs < 75.0
        b := 3
    else if rs < 100.0
        b := 4
    else
        b := 5
    b

bin_label(int b) =>
    switch b
        0 => "0–10%"
        1 => "10–25%"
        2 => "25–50%"
        3 => "50–75%"
        4 => "75–100%"
        5 => "≥100%"
        => "–"

format_pct(float val) =>
    na(val) ? "–" : str.tostring(val, "0") + "%"

format_delta(float val) =>
    na(val) ? "–" : (math.round(val) > 0 ? "+" : "") + str.tostring(math.round(val) == 0 ? 0.0 : val, "0") + " pp"

// ==========================================
// 3. INCREMENTAL COUNTERS (6 BINS + BASE)
// All-history mode stores only counters. Windowed modes use a
// fixed-size ring keyed by C2 bar: at most one setup per bar.
// Each close removes at most one expired event and adds at most
// one matured event. O(1) work per bar, O(window) bounded storage.
// RS bins match [10,25,50,75,100], side='right'.
// code packing: bin | reaches?8 | full?16 | xc2?32
// ==========================================
var int[] bin_n       = array.new_int(6, 0)
var int[] bin_reaches = array.new_int(6, 0)
var int[] bin_full    = array.new_int(6, 0)
var int[] bin_xc2     = array.new_int(6, 0)

// Window ends at the latest confirmed bar, including that bar.
// C2 offsets 0..N-1 are eligible; offsets 0 and 1 are not mature.
int max_lookback = switch bars_mode
    "Last 5000 Bars" => 5000
    "Last 1000 Bars" => 1000
    "Last 500 Bars"  => 500
    => 0
bool is_windowed = max_lookback > 0
var int[] window_codes = array.new_int(max_lookback, -1)

adjust_counts(int code, int change) =>
    int b = code % 8
    array.set(bin_n, b, array.get(bin_n, b) + change)
    if math.floor(code / 8) % 2 == 1
        array.set(bin_reaches, b, array.get(bin_reaches, b) + change)
    if math.floor(code / 16) % 2 == 1
        array.set(bin_full, b, array.get(bin_full, b) + change)
    if math.floor(code / 32) % 2 == 1
        array.set(bin_xc2, b, array.get(bin_xc2, b) + change)

// ==========================================
// 4. HISTORICAL EVENT MEASUREMENT ENGINE
// On bar [0]'s close, the C2 setup at [2] gets its final C3 ([1])
// and C4 ([0]) outcome. Sweep is wick-based, reclaim is
// close-based ("This close is the event").
// Breach is strict < / >; equality holds (not a live stop rule).
// ==========================================
if bar_index >= 3 and barstate.isconfirmed and not is_too_low
    // Expire C2 at bar_index-N, even when this bar adds no setup.
    if is_windowed
        int expired_slot = bar_index % max_lookback
        int expired_code = array.get(window_codes, expired_slot)
        if expired_code >= 0
            adjust_counts(expired_code, -1)
        array.set(window_codes, expired_slot, -1)

    float c1_h = high[3]
    float c1_l = low[3]
    float c1_rng = c1_h - c1_l

    float c2_h = high[2]
    float c2_l = low[2]
    float c2_c = close[2]
    float c2_rng = c2_h - c2_l

    if c1_rng > 0.0 and c2_rng > 0.0
        bool bull_2 = (c2_l < c1_l) and (c2_c > c1_l)
        bool bear_2 = (c2_h > c1_h) and (c2_c < c1_h)
        bool dual_2 = bull_2 and bear_2 // dual-direction outside bars excluded

        bool is_bull_2 = bull_2 and not dual_2
        bool is_bear_2 = bear_2 and not dual_2

        if is_bull_2 or is_bear_2
            float rs_2 = is_bull_2 ? (100.0 * (c2_c - c1_l) / c1_rng) : (100.0 * (c1_h - c2_c) / c1_rng)

            bool f3 = is_bull_2 ? (low[1] < c2_l) : (high[1] > c2_h)
            bool f4 = is_bull_2 ? (low[0] < c2_l) : (high[0] > c2_h)

            bool reaches = not f3
            bool full    = (not f3) and (not f4)
            bool xc2     = f3 or f4

            int b = get_bin(rs_2)
            int code = b + (reaches ? 8 : 0) + (full ? 16 : 0) + (xc2 ? 32 : 0)
            adjust_counts(code, 1)
            if is_windowed
                array.set(window_codes, (bar_index - 2) % max_lookback, code)

int total_n       = array.sum(bin_n)
int total_reaches = array.sum(bin_reaches)
int total_full    = array.sum(bin_full)
int total_xc2     = array.sum(bin_xc2)

// ==========================================
// 5. ACTIVE C2 SETUP TRACKING
// ==========================================
float c1_h_now = high[1]
float c1_l_now = low[1]
float c1_rng_now = c1_h_now - c1_l_now

float c2_h_now = high[0]
float c2_l_now = low[0]
float c2_c_now = close[0]
float c2_rng_now = c2_h_now - c2_l_now

bool valid_now = (c1_rng_now > 0.0) and (c2_rng_now > 0.0)
bool bull_now  = (c2_l_now < c1_l_now) and (c2_c_now > c1_l_now)
bool bear_now  = (c2_h_now > c1_h_now) and (c2_c_now < c1_h_now)
bool dual_now  = bull_now and bear_now

bool is_bull_now  = valid_now and bull_now and not dual_now
bool is_bear_now  = valid_now and bear_now and not dual_now
bool is_setup_now = is_bull_now or is_bear_now

var string active_dir        = ""
var int    active_c2_bar     = na
var float  active_c2_h       = na
var float  active_c2_l       = na
var float  active_rs         = na
var float  active_wick       = na
var float  active_swept      = na
var float  active_extreme    = na
var bool   active_failed     = false
var int    active_failed_bar = na
var int    active_bin        = -1
var string previous_setup    = ""

// Resolve the tracked setup BEFORE a new C2 can replace it.
// Intrabar lows/highs retain a breach for the rest of that bar.
if not na(active_c2_bar) and bar_index > active_c2_bar and bar_index <= active_c2_bar + 2 and not is_too_low
    bool is_fail_now = (active_dir == "Bull" and low < active_c2_l) or (active_dir == "Bear" and high > active_c2_h)
    if is_fail_now and not active_failed
        active_failed     := true
        active_failed_bar := bar_index

// Active setup updates when C2 closes
if barstate.isconfirmed and is_setup_now and not is_too_low
    if not na(active_c2_bar)
        string previous_outcome = active_failed ? "Invalidated " + (active_failed_bar - active_c2_bar == 1 ? "C3" : "C4") :
             bar_index >= active_c2_bar + 2 ? "Full C4 held" : "Replaced in C3 (unfinished)"
        previous_setup := "Previous: " + active_dir + " · " + previous_outcome
    active_dir        := is_bull_now ? "Bull" : "Bear"
    active_c2_bar     := bar_index
    active_c2_h       := c2_h_now
    active_c2_l       := c2_l_now
    active_failed     := false
    active_failed_bar := na
    active_rs         := is_bull_now ? (100.0 * (c2_c_now - c1_l_now) / c1_rng_now) : (100.0 * (c1_h_now - c2_c_now) / c1_rng_now)
    active_wick       := is_bull_now ? (100.0 * (c1_l_now - c2_l_now) / c2_rng_now) : (100.0 * (c2_h_now - c1_h_now) / c2_rng_now)
    active_swept      := is_bull_now ? c1_l_now : c1_h_now
    active_extreme    := is_bull_now ? c2_l_now : c2_h_now
    active_bin        := get_bin(active_rs)

// Setup expiry (C4 close)
bool is_setup_expired = not na(active_c2_bar) and (bar_index > active_c2_bar + 2 or (bar_index == active_c2_bar + 2 and barstate.isconfirmed))

// ==========================================
// 6. PALETTE (light and dark chart backgrounds)
// ==========================================
bool  is_dark  = color.r(chart.bg_color) + color.g(chart.bg_color) + color.b(chart.bg_color) < 382
color ink      = is_dark ? #d1d4dc : #2a2e39   // primary text
color mid      = #787b86                       // secondary text, swept level
color faint    = is_dark ? #5d606b : #b2b5be   // notes, empty values
color frame    = is_dark ? #2a2e39 : #e0e3eb   // table frame and rules
color tbl_bg   = is_dark ? #131722 : #ffffff
color head_bg  = is_dark ? #1e222d : #f8f9fd

// ==========================================
// 7. ACTIVE SETUP DRAWINGS
// Swept C1 extreme (gray, dotted) and the C2 extreme that must hold
// (direction color). On a breach the extreme line turns gray and dotted
// and its price reads XC2. Everything is removed at C4 close.
// ==========================================
var line  l_swept     = na
var line  l_extreme   = na
var label lbl_extreme = na
var label lbl_c2      = na

clear_drawings() =>
    line.delete(l_swept)
    line.delete(l_extreme)
    label.delete(lbl_extreme)
    label.delete(lbl_c2)

if is_too_low or not show_lines
    clear_drawings()
    l_swept     := na
    l_extreme   := na
    lbl_extreme := na
    lbl_c2      := na
else if not na(active_c2_bar)
    int   end_bar = active_c2_bar + 2
    bool  is_bull = active_dir == "Bull"
    color dir_col = is_bull ? bull_col : bear_col
    string px_txt = str.tostring(active_extreme, format.mintick)

    // Fresh C2 close: draw from scratch
    if barstate.isconfirmed and is_setup_now
        clear_drawings()
        l_swept   := line.new(active_c2_bar - 1, active_swept, end_bar, active_swept, color=mid, style=line.style_dotted, width=1)
        l_extreme := line.new(active_c2_bar, active_extreme, end_bar, active_extreme, color=dir_col, style=line.style_solid, width=2)
        lbl_extreme := na
        lbl_c2      := na
        if show_line_labels
            lbl_c2 := label.new(active_c2_bar, active_extreme, "C2 · RS " + str.tostring(active_rs, "0") + "%",
                 style=is_bull ? label.style_label_up : label.style_label_down, color=color(na), textcolor=ink, size=size.small)
            lbl_extreme := label.new(end_bar, active_extreme, px_txt,
                 style=label.style_label_left, color=color(na), textcolor=dir_col, size=size.small)

    // Breach of the C2 extreme during C3 / C4
    if active_failed
        line.set_color(l_extreme, mid)
        line.set_style(l_extreme, line.style_dotted)
        label.set_text(lbl_extreme, "XC2 " + px_txt)
        label.set_textcolor(lbl_extreme, bear_col)

    if not show_line_labels
        label.delete(lbl_extreme)
        label.delete(lbl_c2)
        lbl_extreme := na
        lbl_c2      := na

    // C4 close: setup leaves LIVE status
    if is_setup_expired
        clear_drawings()
        l_swept     := na
        l_extreme   := na
        lbl_extreme := na
        lbl_c2      := na

// ==========================================
// 8. STATS TABLE
// ==========================================
var string table_pos_id = switch tbl_pos
    "Bottom Right" => position.bottom_right
    "Top Left"     => position.top_left
    "Bottom Left"  => position.bottom_left
    => position.top_right

var string table_sz = switch tbl_size_in
    "Normal"  => size.normal
    "Compact" => size.small
    => size.tiny

var table t = na

cell(int col, int row, string txt, color tc, color bg, bool bold = false, string tip = "") =>
    table.cell(t, col, row, txt, bgcolor=bg, text_color=tc, text_size=table_sz, text_font_family=font.family_default,
         text_formatting=bold ? text.format_bold : text.format_none, tooltip=tip)

if barstate.islast
    if is_too_low or not show_tbl
        if not na(t)
            table.delete(t)
            t := na
    else
        if na(t)
            t := table.new(table_pos_id, 6, 12, bgcolor=tbl_bg, frame_color=frame, frame_width=1, border_color=tbl_bg, border_width=0)
            // Merge once per table object; realtime updates only change cell data.
            table.merge_cells(t, 0, 0, 5, 0)
            table.merge_cells(t, 0, 1, 5, 1)
            table.merge_cells(t, 0, 10, 5, 10)
            table.merge_cells(t, 0, 11, 5, 11)

        float base_full_pct    = total_n > 0 ? (total_full * 100.0 / total_n) : na
        float base_reaches_pct = total_n > 0 ? (total_reaches * 100.0 / total_n) : na
        float base_xc2_pct     = total_n > 0 ? (total_xc2 * 100.0 / total_n) : na

        // Row 0: title
        string tf_str = switch
            timeframe.isseconds       => timeframe.period + "s"
            timeframe.period == "60"  => "1H"
            timeframe.period == "240" => "4H"
            timeframe.isminutes       => timeframe.period + "m"
            timeframe.isdaily         => "D"
            timeframe.isweekly        => "W"
            timeframe.ismonthly       => "M"
            => timeframe.period
        cell(0, 0, "Reclaim Strength · " + syminfo.ticker + " · " + tf_str, ink, head_bg, true)

        // Row 1: latest setup
        bool is_live = not na(active_c2_bar) and not is_setup_expired
        string phase_txt = ""
        if is_live
            int bars_since = bar_index - active_c2_bar
            phase_txt := bars_since == 0 ? "C2" : (bars_since == 1 ? "C3" : "C4")
        color  dir_col = active_dir == "Bull" ? bull_col : bear_col
        string status  = ""
        color  st_col  = mid
        if is_live
            if active_failed
                string fail_phase = not na(active_failed_bar) ? (active_failed_bar - active_c2_bar == 1 ? "C3" : "C4") : phase_txt
                status := "XC2 · " + active_dir + " · broke in " + fail_phase
                st_col := bear_col
            else
                status := "● " + active_dir + " · " + phase_txt + " · RS " + str.tostring(active_rs, "0") + "% · Sweep " + str.tostring(active_wick, "0") + "%"
                st_col := dir_col
        else
            status := "Waiting for C2" + (active_dir != "" ? " · last " + active_dir + (active_failed ? ", XC2" : ", held") : "")
        cell(0, 1, status, st_col, tbl_bg, is_live)

        // Row 2: column headers
        cell(0, 2, "RS", mid, head_bg)
        cell(1, 2, "N", mid, head_bg)
        cell(2, 2, "Reach C4", mid, head_bg, false, "Held the C2 extreme through C3.")
        cell(3, 2, "Full C4", mid, head_bg, false, "Held the C2 extreme through C3 and C4.")
        cell(4, 2, "XC2", mid, head_bg, false, "Broke the C2 extreme in C3 or C4.")
        cell(5, 2, "Δ Reach", mid, head_bg, false, "Bucket Reach C4 minus the whole sample's Reach C4, in percentage points (pp).")

        // Rows 3..8: RS buckets; the live setup's bucket is tinted
        for b = 0 to 5
            int   row = 3 + b
            int   cnt = array.get(bin_n, b)
            float r_pct = cnt > 0 ? (array.get(bin_reaches, b) * 100.0 / cnt) : na
            float f_pct = cnt > 0 ? (array.get(bin_full, b) * 100.0 / cnt) : na
            float x_pct = cnt > 0 ? (array.get(bin_xc2, b) * 100.0 / cnt) : na
            float delta = (cnt > 0 and not na(base_reaches_pct)) ? (r_pct - base_reaches_pct) : na
            bool  hot   = is_live and active_bin == b
            color bg    = hot ? color.new(dir_col, 88) : tbl_bg
            color num   = cnt > 0 ? ink : faint
            cell(0, row, bin_label(b), hot ? dir_col : ink, bg, hot)
            cell(1, row, str.tostring(cnt), num, bg)
            cell(2, row, format_pct(r_pct), num, bg)
            cell(3, row, format_pct(f_pct), num, bg)
            cell(4, row, format_pct(x_pct), num, bg)
            float d_rnd = na(delta) ? na : math.round(delta)
            color d_col = na(d_rnd) ? faint : d_rnd > 0 ? bull_col : d_rnd < 0 ? bear_col : mid
            cell(5, row, format_delta(delta), d_col, bg)

        // Row 9: whole sample
        cell(0, 9, "All", ink, head_bg, true)
        cell(1, 9, str.tostring(total_n), ink, head_bg, true)
        cell(2, 9, format_pct(base_reaches_pct), ink, head_bg, true)
        cell(3, 9, format_pct(base_full_pct), ink, head_bg, true)
        cell(4, 9, format_pct(base_xc2_pct), ink, head_bg, true)
        cell(5, 9, "ref", faint, head_bg)

        // Rows 10..11: previous setup and sample
        cell(0, 10, previous_setup == "" ? "Only the latest setup is drawn" : previous_setup, mid, tbl_bg, false,
             "Only the latest C2 is drawn. Previous is its state when a new C2 replaced it; every setup is still measured on its own at its C4 close.")
        cell(0, 11, "Sample: " + (is_windowed ? "last " + str.tostring(max_lookback) + " closed bars" : "all loaded bars"), faint, tbl_bg, false,
             "This chart's feed and timeframe. Rates measure whether the C2 extreme survived, not trade profitability. Small N says little.")
